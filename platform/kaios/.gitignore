# quake2-kaios.js / .js.mem are intentionally committed (see build.sh) so
# the app is sideloadable straight from the repo without a toolchain.
#
# autoexec.cfg.js stays generated/ignored: it's a trivial JSON-escaped
# copy of autoexec.cfg produced on every build, committing it would just
# be a second source of truth that can drift from the .cfg it's derived
# from.
/autoexec.cfg.js
