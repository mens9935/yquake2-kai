# quake2-kaios.js / .js.mem are intentionally committed (see build.sh) so
# the app is sideloadable straight from the repo without a toolchain.
#
# autoexec.cfg.js used to be generated here from autoexec.cfg at build
# time; app.js now fetches autoexec.cfg itself at runtime instead (see
# writeAutoexec() there), so nothing generates that file anymore.
